# =============================================================================
# SQL Generator Agent - Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# --- LLM (OpenAI-compatible endpoint) ----------------------------------------
SQL_GEN_BASE_URL=https://llm.nalits.com/v1
SQL_GEN_MODEL=auto
SQL_GEN_API_KEY=freellmapi-74ce1b49f8e25725bafa87129d3778ddad811a4e5dbe7aec

# --- Oracle database (oracledb thin mode) -------------------------------------
# DSN format: host:port/service_name  e.g. db.corp.local:1521/ORCLPDB1
ORACLE_DSN=(description= (retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=adb.ap-hyderabad-1.oraclecloud.com))(connect_data=(service_name=gbff7636e668fee_marketplacedata_high.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))
ORACLE_USER=ADMIN
ORACLE_PASSWORD=070114@Mapa1

# --- Langfuse (self-hosted observability) -------------------------------------
LANGFUSE_SECRET_KEY="sk-lf-f6cca6fa-9cef-42cf-9dab-5260e9959c52"
LANGFUSE_PUBLIC_KEY="pk-lf-93267cda-9624-400c-b7ff-740771f3c592"
LANGFUSE_HOST="https://fuse.nalits.com"
# Increase the OTLP export timeout (s) for the self-hosted Langfuse instance.
LANGFUSE_TIMEOUT=30
# Set to false to run without shipping traces to Langfuse.
LANGFUSE_ENABLED=true

# --- Agent behaviour ----------------------------------------------------------
# Maximum number of validate -> generate retry loop iterations.
# MAX_SQL_ATTEMPTS=3