# =============================================================================
# SQL Generator Agent - Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# --- LLM (OpenAI-compatible endpoint) ----------------------------------------
SQL_GEN_BASE_URL=https://llm.nalits.com/v1
SQL_GEN_MODEL=gpt-4o
SQL_GEN_API_KEY=replace-me-with-your-api-key

# --- Oracle database (oracledb thin mode) -------------------------------------
# DSN format: host:port/service_name  e.g. db.corp.local:1521/ORCLPDB1
ORACLE_DSN=replace-me:1521/service
ORACLE_USER=replace-me
ORACLE_PASSWORD=replace-me

# --- Langfuse (self-hosted observability) -------------------------------------
LANGFUSE_HOST=https://langfuse.yourcorp.local
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
# Set to false to run without shipping traces to Langfuse.
LANGFUSE_ENABLED=true

# --- Agent behaviour ----------------------------------------------------------
# Maximum number of validate -> generate retry loop iterations.
# MAX_SQL_ATTEMPTS=3